# NOTE: JSON configuration in Visual Studio Code doesn't support default value for environment variables.
# Since there is no fallback to a default value, you must specify the value rather than omitting it. E.g. WORDPRESS_INSTALL_ADMIN_USER
# https://code.visualstudio.com/docs/reference/variables-reference#_environment-variables

# Versions
WORDPRESS_CONTAINER_VERSION="php8.5-apache"  # MUST use apache variant
WORDPRESS_CORE_VERSION="latest"
MYSQL_VERSION="lts"  # Generally, cheap web hosting services use quite old versions of MySQL.
MARIADB_VERSION="latest"
MAILPIT_VERSION="latest"

# WordPress locale setting
WORDPRESS_LOCALE="en_US"

# WordPress database settings
WORDPRESS_DB_HOST="db"
WORDPRESS_DB_NAME="wordpress"
WORDPRESS_DB_USER="wordpress"
WORDPRESS_DB_PASSWORD="wordpress"
WORDPRESS_DB_PREFIX="wp_"
WORDPRESS_DB_CHARSET="utf8"
WORDPRESS_DB_COLLATE=""

# WordPress installation settings
WORDPRESS_URL="http://localhost"
WORDPRESS_INSTALL_TITLE="WordPress in dev container"
WORDPRESS_INSTALL_ADMIN_USER="admin"
WORDPRESS_INSTALL_ADMIN_PASSWORD="password"
WORDPRESS_INSTALL_ADMIN_EMAIL="admin@wordpress.local"

# WordPress cron job interval
# WP_CRON_INTERVAL="1m"

# display resolution for "ghcr.io/devcontainers/features/desktop-lite:1"
VNC_RESOLUTION="1440x900x16"

# Debugging in Playwright tests
# DEBUG="pw:api"

# APACHE_EXTRA_MODULES="proxy proxy_http"
